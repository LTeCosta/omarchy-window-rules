    {"description": "monitor of 128 code points", "rules": [{"monitor": "desc:mmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "apps mode with two classes", "rules": [{"match": {"mode": "apps", "classes": ["com.microsoft.VSCode", "com.t3tools.T3Code"]}}], "expect": {"file": "ok", "rules": ["ok"]}},
