  "textCases": [
    {"description": "zero-byte file", "text": "", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "truncated JSON", "text": "{", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "byte order mark", "text": "﻿{\"version\":1,\"rules\":[]}", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "trailing content", "text": "{\"version\":1,\"rules\":[]} x", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "lone high surrogate in a string", "text": "{\"version\":1,\"rules\":[{\"id\":\"a\",\"name\":\"\\ud800\",\"match\":{\"class\":\"^a$\"}}]}", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "number that overflows a double", "text": "{\"version\":1,\"revision\":1e400,\"rules\":[]}", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "nesting deeper than 64 levels", "text": "{\"version\":1,\"rules\":[],\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}", "expect": {"file": "invalid-json", "rules": []}},
    {"description": "nesting of exactly 64 levels", "text": "{\"version\":1,\"rules\":[],\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}", "expect": {"file": "ok", "rules": []}},
    {"description": "minimal valid text", "text": "{\"version\":1,\"rules\":[]}", "expect": {"file": "ok", "rules": []}},
    {"description": "escaped NUL in a name is a control character", "text": "{\"version\":1,\"rules\":[{\"id\":\"a\",\"name\":\"a\\u0000b\",\"match\":{\"class\":\"^a$\"}}]}", "expect": {"file": "ok", "rules": ["invalid-name"]}}
  ],
  "compileCases": [
    {"description": "apps join escaped classes", "match": {"mode": "apps", "classes": ["com.microsoft.VSCode", "com.t3tools.T3Code"]}, "expect": {"class": "^(com\\.microsoft\\.VSCode|com\\.t3tools\\.T3Code)$"}},
    {"description": "one app", "match": {"mode": "apps", "classes": ["teams-for-linux"]}, "expect": {"class": "^(teams\\-for\\-linux)$"}},
    {"description": "ASCII punctuation and space are escaped, other characters are not", "match": {"mode": "apps", "classes": ["a+b (x)_é"]}, "expect": {"class": "^(a\\+b\\ \\(x\\)_é)$"}},
    {"description": "regex mode passes the pattern through", "match": {"mode": "regex", "class": "^(steam|steam_app_.+)$"}, "expect": {"class": "^(steam|steam_app_.+)$"}},
    {"description": "missing mode is regex", "match": {"class": "steam"}, "expect": {"class": "steam"}},
    {"description": "exact title is escaped and anchored", "match": {"mode": "apps", "classes": ["a"], "title": "Steam - News", "titleMode": "exact"}, "expect": {"class": "^(a)$", "title": "^Steam\\ \\-\\ News$"}},
    {"description": "regex title passes through", "match": {"class": "^a$", "title": ".*Steam.*", "titleMode": "regex"}, "expect": {"class": "^a$", "title": ".*Steam.*"}},
    {"description": "missing title mode is regex", "match": {"class": "^a$", "title": "x.y"}, "expect": {"class": "^a$", "title": "x.y"}},
    {"description": "empty title adds no title key", "match": {"class": "^a$", "title": "", "titleMode": "exact"}, "expect": {"class": "^a$"}},
    {"description": "initial uses initial_class and initial_title", "match": {"mode": "apps", "classes": ["a"], "title": "T", "titleMode": "exact", "initial": true}, "expect": {"initial_class": "^(a)$", "initial_title": "^T$"}}
  ]
}
