    {"description": "monitor slot", "rules": [{"workspace": {"type": "monitor-slot", "monitor": "desc:Vendor Model Serial", "slot": 3}}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "monitor slot without desc prefix", "rules": [{"workspace": {"type": "monitor-slot", "monitor": "DP-2", "slot": 3}}], "expect": {"file": "ok", "rules": ["invalid-workspace"]}},
