{
  "about": "Conformance cases for the rules.json v1 schema. Model.js (tests/model.test.js) and hypr/schema.lua (tests/schema_test.lua) must both return exactly the expected codes. A case either gives a whole `document`, or `rules`: overrides shallow-merged onto `baseRule`, where `$unset` lists top-level keys to remove. `expect.file` is `ok` or a file error code; `expect.rules` holds, per rule, `ok` or its first error code in the documented check order; `expect.warnings`, when present, holds the warning codes per rule. Regex syntax errors are checked by Model.js only and are not part of these cases. `textCases` give raw file text that each implementation parses with its own JSON parser; `expect.file` is then `invalid-json` when the text is not acceptable JSON (empty text, a BOM, trailing content, a lone surrogate, a number that overflows a double, nesting deeper than 64 levels). `compileCases` give a valid `match` and the exact Hyprland match properties both implementations must produce (`compileMatch`): apps mode joins the classes as ^(c1|c2)$, exact titles become ^title$, and in both every ASCII character other than a letter, a digit or `_` is escaped with a backslash while other characters are copied; regex mode and a missing mode pass the pattern through; `initial` uses initial_class/initial_title.",
  "baseRule": {"id": "base", "name": "Base", "enabled": true, "match": {"class": "^base$", "title": ""}, "workspace": {"type": "none"}, "follow": true, "layout": "default", "size": null, "position": {"type": "none"}, "monitor": null, "fullscreen": false, "maximize": false, "pin": false, "opacity": null, "noInitialFocus": false},
  "cases": [
    {"description": "empty rule list", "document": {"version": 1, "revision": 0, "rules": []}, "expect": {"file": "ok", "rules": []}},
    {"description": "base rule is valid", "rules": [{}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "missing revision defaults to 0", "document": {"version": 1, "rules": []}, "expect": {"file": "ok", "rules": []}},
    {"description": "not an object", "document": [], "expect": {"file": "invalid-file", "rules": []}},
    {"description": "missing version", "document": {"rules": []}, "expect": {"file": "invalid-file", "rules": []}},
    {"description": "string version", "document": {"version": "1", "rules": []}, "expect": {"file": "invalid-file", "rules": []}},
    {"description": "future version", "document": {"version": 2, "rules": []}, "expect": {"file": "unsupported-version", "rules": []}},
    {"description": "negative revision", "document": {"version": 1, "revision": -1, "rules": []}, "expect": {"file": "invalid-revision", "rules": []}},
    {"description": "revision above 2^53 - 1", "document": {"version": 1, "revision": 9007199254740992, "rules": []}, "expect": {"file": "invalid-revision", "rules": []}},
    {"description": "fractional revision", "document": {"version": 1, "revision": 1.5, "rules": []}, "expect": {"file": "invalid-revision", "rules": []}},
    {"description": "rules not an array", "document": {"version": 1, "revision": 0, "rules": {}}, "expect": {"file": "invalid-file", "rules": []}},
    {"description": "rule that is not an object", "document": {"version": 1, "revision": 0, "rules": ["x"]}, "expect": {"file": "ok", "rules": ["invalid-rule"]}},
    {"description": "id with uppercase", "rules": [{"id": "Steam"}], "expect": {"file": "ok", "rules": ["invalid-id"]}},
    {"description": "id starting with a dash", "rules": [{"id": "-x"}], "expect": {"file": "ok", "rules": ["invalid-id"]}},
    {"description": "id of 48 characters", "rules": [{"id": "a23456789012345678901234567890123456789012345678"}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "id of 49 characters", "rules": [{"id": "a234567890123456789012345678901234567890123456789"}], "expect": {"file": "ok", "rules": ["invalid-id"]}},
    {"description": "missing id", "rules": [{"$unset": ["id"]}], "expect": {"file": "ok", "rules": ["invalid-id"]}},
    {"description": "duplicate id keeps the first", "rules": [{"id": "dup"}, {"id": "dup"}], "expect": {"file": "ok", "rules": ["ok", "duplicate-id"]}},
    {"description": "empty name", "rules": [{"name": ""}], "expect": {"file": "ok", "rules": ["invalid-name"]}},
    {"description": "name with a control character", "rules": [{"name": "a\u0007b"}], "expect": {"file": "ok", "rules": ["invalid-name"]}},
    {"description": "name of 81 characters", "rules": [{"name": "123456789012345678901234567890123456789012345678901234567890123456789012345678901"}], "expect": {"file": "ok", "rules": ["invalid-name"]}},
    {"description": "markup-shaped name is plain text and valid", "rules": [{"name": "<img src=\"https://example.invalid/t\">"}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "enabled as a string", "rules": [{"enabled": "yes"}], "expect": {"file": "ok", "rules": ["invalid-flag"]}},
    {"description": "missing optional fields take defaults", "rules": [{"$unset": ["enabled", "workspace", "follow", "layout", "size", "position", "monitor", "fullscreen", "maximize", "pin", "opacity", "noInitialFocus"]}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "missing match", "rules": [{"$unset": ["match"]}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "empty class", "rules": [{"match": {"class": ""}}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "class with lookahead", "rules": [{"match": {"class": "^a(?=b)"}}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "class with lookbehind", "rules": [{"match": {"class": "(?<=x)y"}}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "class with negative lookbehind", "rules": [{"match": {"class": "(?<!x)y"}}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "class with a backreference", "rules": [{"match": {"class": "(a)\\1"}}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "class with a JS named group", "rules": [{"match": {"class": "(?<app>steam)"}}], "expect": {"file": "ok", "rules": ["invalid-class"]}},
    {"description": "class with an escaped backslash before a digit is not a backreference", "rules": [{"match": {"class": "a\\\\1"}}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "class with alternation and non-capturing group", "rules": [{"match": {"class": "^(?:steam|steam_app_.+)$"}}], "expect": {"file": "ok", "rules": ["ok"]}},
    {"description": "title with lookahead", "rules": [{"match": {"class": "^a$", "title": "(?!x)"}}], "expect": {"file": "ok", "rules": ["invalid-title"]}},
    {"description": "title not a string", "rules": [{"match": {"class": "^a$", "title": 5}}], "expect": {"file": "ok", "rules": ["invalid-title"]}},
    {"description": "unknown match keys are ignored", "rules": [{"match": {"class": "^a$", "xwayland": true}}], "expect": {"file": "ok", "rules": ["ok"]}},
